# Editor defaults that match what the repository already stores: UTF-8 without BOM, LF line
# endings, a final newline, spaces for indentation. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Same width as `max_width` in rustfmt.toml; `cargo fmt` is still the authority.
[*.rs]
max_line_length = 150

[*.{yml,yaml,json,sh,ps1,svg,xml,wxs,wxi,plist,in}]
indent_size = 2

# A trailing double space is a Markdown line break.
[*.md]
trim_trailing_whitespace = false

# Generated by Cargo.
[Cargo.lock]
trim_trailing_whitespace = unset
insert_final_newline = unset
